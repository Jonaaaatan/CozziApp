{
  "expo": {
    "name": "CozziApp",
    "slug": "CozziApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cozziIcon.png",
    "splash": {
      "image": "./assets/cozziIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Cozzi necesita acceso al micrófono para escuchar tus comandos de cocina.",
          "speechRecognitionPermission": "Cozzi usa el reconocimiento de voz para ejecutar tus comandos de cocina."
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/cozzi-notification-icon.png",
          "largeIcon": "./assets/cozziIcon.png",
          "color": "#C4262E"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/cozzi-adaptive-foreground.png",
        "monochromeImage": "./assets/cozzi-adaptive-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.CozziApp"
    },
    "web": {
      "favicon": "./assets/cozziIcon.png"
    }
  }
}
